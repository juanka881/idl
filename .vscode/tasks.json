{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Idle: Build native server",
      "type": "shell",
      "command": "zig build",
      "options": {
        "cwd": "${workspaceFolder}/dev/idl-lsp"
      },
      "problemMatcher": []
    },
    {
      "label": "Idle: Build extension",
      "type": "shell",
      "command": "pnpm run build",
