      },
      "problemMatcher": []
    },
    {
      "label": "Idle: Build server and extension",
      "dependsOn": [
        "Idle: Build native server",
        "Idle: Build extension"
      ],
      "dependsOrder": "sequence",
      "group": "build"
    }
  ]
}
